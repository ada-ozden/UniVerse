# Ignore hidden files and folders (e.g. .DS_Store)
.*
!.gitignore
!.gitattributes
# OS-specific files
.DS_Store
Thumbs.db

# Folders generated by Unity
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/
[Pp]ackages/
UserSettings/

# Asset meta data should be tracked
!/[Aa]ssets/**/*.meta

# Uncomment this line if you have Unity Cloud Build configured
#[Cc]loudBuild/

# Visual Studio/VSCode
.vscode/
.vs/
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db
*.pdb

# Rider
.idea/
.idea/*

# Autogenerated JetBrains Rider plugin
Plugins/Editor/JetBrains*

# Ignore crash reports
[Cc]rash[Aa]nalyzer/

# Ignore Builds
/Build/
